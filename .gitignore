# Dependencies
node_modules/

# Build output
dist/
build/

# Environment / secrets (never commit real tokens or config)
.env
.env.local
.env.*.local

# Tests / coverage
coverage/
*.lcov

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Scratch
scratchpad/

# Subagent-driven-development workspace (internal ledger/briefs/reports)
.superpowers/

# graphify — commit graph.json + GRAPH_REPORT.md (refreshed once before each PR,
# not per code commit); ignore machine-specific + incremental/temp sidecars.
graphify-out/.graphify_python
graphify-out/.graphify_root
graphify-out/.graphify_*.json
graphify-out/.graphify_*.sig
graphify-out/manifest.json
graphify-out/cache/
graphify-out/*.html
graphify-out/cost.json
# stray AST cache that lands wherever graphify scans (e.g. src/graphify-out/)
**/graphify-out/cache/
src/graphify-out/
