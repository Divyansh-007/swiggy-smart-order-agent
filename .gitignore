# Dependencies
node_modules/

# Build output
dist/
build/

# Environment / secrets (never commit real tokens or config)
.env
.env.local
.env.*.local

# Tests / coverage
coverage/
*.lcov

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Scratch
scratchpad/

# Subagent-driven-development workspace (internal ledger/briefs/reports)
.superpowers/

# graphify — the knowledge graph is a GENERATED artifact that graphify rebuilds
# on every code change (`graphify update .`), so committing it churns every code
# commit (an 11k-line graph.json diff rode along with a small cart change once).
# Keep it local: build/refresh with `graphify .` / `graphify update .`.
graphify-out/
**/graphify-out/
